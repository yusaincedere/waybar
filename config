{
  "layer": "top",
  "position": "top",
  "height": 44,
  "modules-left": [
    "custom/home",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "custom/vpn",
    "custom/resources",
    "custom/batteryprofile",
    "tray",
    "custom/systemmonitor",
    "custom/power"
  ],
  "custom/home": {
    "format": "󰍜",
    "tooltip": true,
    "tooltip-format": "Left click: Desktop\nRight click: Home",
    "on-click": "bash -lc 'mkdir -p \"$HOME/Desktop\"; setsid -f dolphin --new-window \"$HOME/Desktop\" >/dev/null 2>&1'",
    "on-click-right": "bash -lc 'setsid -f dolphin --new-window \"$HOME\" >/dev/null 2>&1'"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "●",
      "default": "○"
    }
  },
  "hyprland/window": {
    "format": "{}",
    "max-length": 45
  },
  "clock": {
    "format": " {:%a %d %b  %H:%M}",
    "tooltip-format": "<big>{:%A, %d %B %Y}</big>",
    "on-click": "gnome-calendar",
    "on-click-right": "swaync-client -t -sw"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-click-middle": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 50%",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\nLeft click: mute\nScroll: change volume\nRight click: volume control\nMiddle click: set 50%"
  },
  "custom/vpn": {
    "exec": "~/.config/waybar/scripts/protonvpn-status.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "~/.config/waybar/scripts/protonvpn-toggle.sh",
    "on-click-right": "kitty -e protonvpn status",
    "tooltip": true
  },
  "custom/batteryprofile": {
    "exec": "~/.config/waybar/scripts/battery-profile.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/power-profile-toggle.sh"
  },
  "custom/resources": {
    "exec": "~/.config/waybar/scripts/resources.sh",
    "interval": 3,
    "return-type": "json",
    "tooltip": true,
    "on-click": "missioncenter",
    "on-click-right": "kitty -e btop"
  },
  "tray": {
    "spacing": 10
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": true,
    "tooltip-format": "Power menu",
    "on-click": "~/.config/waybar/scripts/power-menu.sh"
  }
}
